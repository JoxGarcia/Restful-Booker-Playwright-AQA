{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@data/*": ["data/*"],
      "@fixtures/*": ["fixtures/*"],
      "@flows/*": ["flows/*"],
      "@support/*": ["support/*"],
      "@utils/*": ["utils/*"]
    },
    "types": ["node"],
    "moduleResolution": "node16",        
    "target": "ES2022",
    "module": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}